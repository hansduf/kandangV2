<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Action 1: + Telur -->
    <LinearLayout
        android:id="@+id/btn_action_egg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_action"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥚"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Telur"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 2: + Pakan -->
    <LinearLayout
        android:id="@+id/btn_action_feed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_action"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌾"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Pakan"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 3: + Obat -->
    <LinearLayout
        android:id="@+id/btn_action_health"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_action"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Obat"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action 4: Tugas -->
    <LinearLayout
        android:id="@+id/btn_action_tasks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_action"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tugas"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
