<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card_white"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Month Title & Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_calendar_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="September 2026"
            android:textColor="#0F172A"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <!-- Prev Month Button -->
        <TextView
            android:id="@+id/btn_cal_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_tab_inactive_bg"
            android:gravity="center"
            android:text="‹"
            android:textColor="#334155"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Next Month Button -->
        <TextView
            android:id="@+id/btn_cal_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_tab_inactive_bg"
            android:gravity="center"
            android:text="›"
            android:textColor="#334155"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Quick Add Button (Black pill matching screenshot) -->
        <TextView
            android:id="@+id/btn_cal_add"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_add_black"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+ Catat"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Monthly Calendar Grid Canvas (Fixed DP height to avoid 0dp RemoteViews collapse) -->
    <ImageView
        android:id="@+id/widget_calendar_image"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_calendar_preview" />

    <!-- Bottom: Task Explanation Card -->
    <LinearLayout
        android:id="@+id/widget_calendar_task_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_metric_box_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 TUGAS HARI INI"
                android:textColor="#0F172A"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_calendar_worker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_amber"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Pekerja: P roni"
                android:textColor="#92400E"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/task_check_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#00684A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="16:30 Catat Produksi Telur (Kandang W)"
                android:textColor="#1E293B"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/task_check_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cek Sanitasi &amp; Sekam (Kandang 1)"
                android:textColor="#1E293B"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Footer Link -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Buka Agenda Tugas ↗"
            android:textColor="#00684A"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
