<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_slate"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Title & Role Profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 Kalender &amp; Tugas"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_calendar_worker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Pekerja: Budi"
            android:textColor="#FDE047"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7-Day Calendar Strip Row -->
    <LinearLayout
        android:id="@+id/widget_days_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1E293B"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/day_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sn\n12"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/day_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sl\n13"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Rb\n14"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/day_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Km\n15"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/day_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Jm\n16"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/day_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sb\n17"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/day_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mg\n18"
            android:textColor="#F87171"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Task List Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Task 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/task_check_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="07:00 Panen Telur Pagi (Kandang 1)"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/task_check_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#FDE047"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/task_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="08:30 Beri Pakan Pagi &amp; Cek Air"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/task_check_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/task_text_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="10:00 Vaksinasi ND &amp; Pembersihan"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer -->
    <TextView
        android:id="@+id/widget_calendar_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Semua tugas sinkron • Ketuk untuk checklist"
        android:textColor="#94A3B8"
        android:textSize="9sp" />

</LinearLayout>
